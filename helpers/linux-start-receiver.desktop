[Desktop Entry]
Type=Application
Name=DOMScout - Start Receiver
Comment=Start the DOMScout local report receiver
Terminal=true
Exec=/bin/sh -c "cd \"$(dirname \"$1\")/..\" || exit 1; if [ ! -f domscout.receiver.js ]; then echo 'Could not find domscout.receiver.js in the project root.'; read -r _; exit 1; fi; if ! command -v node >/dev/null 2>&1; then echo 'Node.js (node) is required.'; read -r _; exit 1; fi; node domscout.receiver.js; status=$?; if [ $status -ne 0 ]; then echo 'DOMScout receiver stopped with an error.'; read -r _; fi; exit $status" sh %k
Categories=Development;
